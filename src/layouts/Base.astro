---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/consts";
import { getLocale, stripLocale, alternates } from "@/i18n/utils";
import { htmlLang, defaultLocale } from "@/i18n/ui";

interface Props {
  title: string;
  description?: string;
  /** chemin canonique SANS préfixe de langue, ex. "/boutique/" */
  path?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, path, image, noindex } = Astro.props;

const locale = getLocale(Astro.url);
const pathNoLocale = path ?? stripLocale(Astro.url.pathname);
const canonical = new URL(
  locale === defaultLocale ? pathNoLocale : `/${locale}${pathNoLocale}`,
  SITE.url,
).href;

const hreflangs = alternates(pathNoLocale).map(({ locale: l, path: p }) => ({
  hreflang: htmlLang[l],
  href: new URL(p, SITE.url).href,
}));
const xDefault = new URL(pathNoLocale, SITE.url).href;

const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Questrial&family=Quattrocento+Sans:wght@400;700&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="kx-skip" href="#main">Aller au contenu</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <style>
      .kx-skip {
        position: absolute;
        left: 0.5rem;
        top: 0.5rem;
        transform: translateY(-150%);
        background: var(--kx-petrol);
        color: #fff;
        padding: 0.6em 1em;
        border-radius: var(--kx-radius);
        z-index: 100;
        transition: transform 0.15s ease;
      }
      .kx-skip:focus {
        transform: translateY(0);
      }
      main {
        min-height: 50vh;
      }
    </style>
  </body>
</html>
