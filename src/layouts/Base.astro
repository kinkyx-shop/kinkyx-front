---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/consts";
import { getLocale, stripLocale, alternates as computeAlternates } from "@/i18n/utils";
import { htmlLang, defaultLocale, locales, type Locale } from "@/i18n/ui";

interface Props {
  title: string;
  description?: string;
  /** chemin canonique SANS préfixe de langue (repli si `alternates` absent) */
  path?: string;
  /** URLs alternées explicites par langue (chemins préfixés, ex. "/en/latex/woman/") */
  alternates?: Partial<Record<Locale, string>>;
  image?: string;
  noindex?: boolean;
}

const { title, description, path, alternates, image, noindex } = Astro.props;

const locale = getLocale(Astro.url);

// URLs par langue
let altPaths: Record<Locale, string>;
if (alternates) {
  altPaths = Object.fromEntries(
    locales.map((l) => [l, alternates[l] ?? Astro.url.pathname]),
  ) as Record<Locale, string>;
} else {
  const pathNoLocale = path ?? stripLocale(Astro.url.pathname);
  altPaths = Object.fromEntries(
    computeAlternates(pathNoLocale).map(({ locale: l, path: p }) => [l, p]),
  ) as Record<Locale, string>;
}

const forceNoindex =
  import.meta.env.PUBLIC_NOINDEX === "1" || import.meta.env.PUBLIC_NOINDEX === "true";

const canonical = new URL(altPaths[locale], SITE.url).href;
const hreflangs = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(altPaths[l], SITE.url).href,
}));
const xDefault = new URL(altPaths[defaultLocale], SITE.url).href;

const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || forceNoindex) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:locale" content={htmlLang[locale].replace("-", "_")} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={htmlLang[l].replace("-", "_")} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href={new URL(SITE.checkoutUrl).origin} crossorigin />
    <link rel="dns-prefetch" href={new URL(SITE.checkoutUrl).origin} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Questrial&family=Quattrocento+Sans:wght@400;700&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />
  </head>
  <body>
    <a class="kx-skip" href="#main">Aller au contenu</a>
    <Header locale={locale} alternates={altPaths} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import "../scripts/cart";
      import "../scripts/wishlist";
    </script>

    <style>
      .kx-skip {
        position: absolute;
        left: 0.5rem;
        top: 0.5rem;
        transform: translateY(-150%);
        background: var(--kx-petrol);
        color: #fff;
        padding: 0.6em 1em;
        border-radius: var(--kx-radius);
        z-index: 100;
        transition: transform 0.15s ease;
      }
      .kx-skip:focus {
        transform: translateY(0);
      }
      main {
        min-height: 50vh;
      }
    </style>
  </body>
</html>
