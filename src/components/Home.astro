---
import ProductCard from "@/components/ProductCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import Stars from "@/components/Stars.astro";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { catalog, isStub, topCategories, categoryPath } from "@/lib/catalog";
import { getPage, pagePath } from "@/lib/pages";
import { organization, website } from "@/lib/jsonld";
import { universRoots } from "@/lib/nav";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const roots = universRoots();
const univers = roots.length ? roots : topCategories().slice(0, 3);
const newest = catalog.products.slice(0, 10);
const bespoke = getPage("latex-sur-mesure");
const google = catalog.google;
const gReviews = (google?.reviews ?? []).slice(0, 4);

const latexRoot = roots.find((c) => c.slug.fr === "latex") ?? roots[0];
const bespokeBg = latexRoot?.image ?? null;
const bespokeBgSrcset = latexRoot?.imageSrcset ?? null;
const heroPic =
  univers[0]?.image
    ? { src: univers[0].image, srcset: univers[0].imageSrcset ?? null }
    : (() => {
        const im = catalog.products.find((p) => p.images[0])?.images[0];
        return im ? { src: im.src, srcset: im.srcset ?? null } : null;
      })();
const heroImg = heroPic?.src ?? null;

const roadmap = [
  ["L0", "Socle · routage i18n · design", true],
  ["L1", "Catalogue & navigation", !isStub],
  ["L2", "Fiche produit & variations", !isStub],
  ["L3", "Panier & passage en caisse", !isStub],
  ["L4", "Pages de contenu", !isStub],
  ["L5", "Recherche · perf · SEO", false],
  ["L6", "Bascule", false],
] as const;
---

{
  isStub ? (
    <section class="kx-home kx-container">
      <p class="kx-eyebrow">Kinkyx</p>
      <h1>{t("meta.tagline")}</h1>
      <p class="kx-home__lead">Nouvelle version en construction — catalogue non branché.</p>
      <ol class="kx-roadmap">
        {roadmap.map(([id, text, done]) => (
          <li class:list={{ "is-done": done }}>
            <span class="kx-roadmap__id">{id}</span>
            <span>{text}</span>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <>
      <JsonLd data={[organization(), website(locale)]} />
      {
        heroImg && (
          <link
            rel="preload"
            as="image"
            href={heroImg}
            imagesrcset={heroPic?.srcset ?? undefined}
            imagesizes="100vw"
            fetchpriority="high"
          />
        )
      }
      <section class="kx-hero">
        {heroImg && (
          <img
            class="kx-hero__bg"
            src={heroImg}
            srcset={heroPic?.srcset ?? undefined}
            sizes="100vw"
            alt=""
            fetchpriority="high"
            width="1600"
            height="900"
          />
        )}
        <div class="kx-hero__inner kx-container">
          <p class="kx-eyebrow kx-hero__eyebrow">Kinkyx</p>
          <h1>{t("meta.tagline")}</h1>
          <p class="kx-hero__sub">{t("home.sub")}</p>
          <a class="kx-btn kx-hero__cta" href={univers[0] ? categoryPath(univers[0], locale) : "/"}>
            {t("home.cta")}
          </a>
        </div>
      </section>

      <section class="kx-container kx-block">
        <h2>{t("home.universes")}</h2>
        <ul class="kx-univers">
          {univers.map((c) => (
            <li>
              <a href={categoryPath(c, locale)}>
                {c.image && (
                  <img
                    src={c.image}
                    srcset={c.imageSrcset ?? undefined}
                    sizes="(min-width: 34rem) 45vw, 92vw"
                    alt=""
                    loading="lazy"
                    width="640"
                    height="480"
                  />
                )}
                <span>{c.name[locale] || c.name.fr}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {gReviews.length > 0 && (
        <section class="kx-gr">
          <div class="kx-container">
            <div class="kx-gr__head">
              <h2>{t("home.googleTitle")}</h2>
              {google?.rating != null && (
                <p class="kx-gr__agg">
                  <Stars value={google.rating} size="1.15rem" />
                  <strong>{google.rating.toFixed(1).replace(".", ",")}</strong>
                  <span>· {google.total} {t("home.googleCount")}</span>
                </p>
              )}
            </div>
            <ul class="kx-gr__list">
              {gReviews.map((r) => (
                <li class="kx-gr__item">
                  <div class="kx-gr__meta">
                    <Stars value={r.rating} size="0.9rem" />
                    <span class="kx-gr__author">{r.author}</span>
                    <span class="kx-gr__when">{r.when}</span>
                  </div>
                  <p class="kx-gr__text">{r.text}</p>
                </li>
              ))}
            </ul>
            {google?.url && (
              <a class="kx-btn kx-btn--ghost kx-gr__more" href={google.url} target="_blank" rel="noopener">
                {t("home.googleAll")}
              </a>
            )}
          </div>
        </section>
      )}

      {bespoke && (
        <section class="kx-bespoke">
          {bespokeBg && (
            <img
              class="kx-bespoke__bg"
              src={bespokeBg}
              srcset={bespokeBgSrcset ?? undefined}
              sizes="100vw"
              alt=""
              loading="lazy"
              width="1600"
              height="900"
            />
          )}
          <div class="kx-container kx-bespoke__inner">
            <div>
              <h2>{t("home.bespokeTitle")}</h2>
              <p>{t("home.bespokeText")}</p>
              <a class="kx-btn kx-btn--ghost" href={pagePath(bespoke, locale)}>
                {t("home.bespokeCta")}
              </a>
            </div>
          </div>
        </section>
      )}

      {newest.length > 0 && (
        <section class="kx-container kx-block">
          <h2>{t("home.newIn")}</h2>
          <div class="kx-grid">
            {newest.map((p) => (
              <ProductCard product={p} locale={locale} />
            ))}
          </div>
        </section>
      )}
    </>
  )
}

<style>
  .kx-hero {
    position: relative;
    background: var(--kx-petrol);
    color: #fff;
    overflow: hidden;
  }
  .kx-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }
  .kx-hero__inner {
    position: relative;
    padding-block: clamp(3.5rem, 10vw, 7rem);
    max-width: 46rem;
  }
  .kx-hero__eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }
  .kx-hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin: 0.4rem 0 0.8rem;
  }
  .kx-hero__sub {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--kx-text-lg);
    max-width: 40ch;
    margin-bottom: 1.75rem;
  }
  .kx-hero__cta {
    background: #fff;
    border-color: #fff;
    color: var(--kx-petrol);
  }
  .kx-hero__cta:hover {
    background: var(--kx-red);
    border-color: var(--kx-red);
    color: #fff;
  }

  .kx-block {
    padding-block: 3rem;
  }
  .kx-block h2 {
    margin-bottom: 1.5rem;
  }

  .kx-gr {
    background: var(--kx-raise);
    border-block: 1px solid var(--kx-line);
    padding-block: 3rem;
  }
  .kx-gr__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .kx-gr__head h2 {
    margin: 0;
  }
  .kx-gr__agg {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--kx-text-sm);
    color: var(--kx-muted);
  }
  .kx-gr__agg strong {
    color: var(--kx-ink);
    font-size: 1.1rem;
  }
  .kx-gr__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .kx-gr__item {
    background: var(--kx-paper);
    border: 1px solid var(--kx-line);
    border-radius: var(--kx-radius);
    padding: 1rem 1.1rem;
  }
  .kx-gr__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin-bottom: 0.5rem;
  }
  .kx-gr__author {
    font-weight: 700;
    font-size: var(--kx-text-sm);
  }
  .kx-gr__when {
    font-size: var(--kx-text-xs);
    color: var(--kx-muted);
    margin-left: auto;
  }
  .kx-gr__text {
    margin: 0;
    font-size: var(--kx-text-sm);
    color: var(--kx-body);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .kx-gr__more {
    margin-top: 1.75rem;
  }

  .kx-univers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .kx-univers a {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--kx-petrol);
    text-decoration: none;
  }
  .kx-univers img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: transform 0.4s ease, opacity 0.2s ease;
  }
  .kx-univers a:hover img {
    transform: scale(1.05);
    opacity: 0.62;
  }
  .kx-univers span {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    color: #fff;
    font-family: var(--kx-font-display);
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kx-bespoke {
    position: relative;
    overflow: hidden;
    margin-block: 3.5rem;
    background: var(--kx-petrol);
    color: #fff;
  }
  .kx-bespoke__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
  }
  .kx-bespoke__inner {
    position: relative;
    padding-block: 4rem;
    max-width: var(--kx-measure);
  }
  .kx-bespoke__inner h2 {
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .kx-bespoke__inner p {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--kx-text-sm);
    margin-bottom: 1.25rem;
  }
  .kx-bespoke__inner .kx-btn--ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .kx-bespoke__inner .kx-btn--ghost:hover {
    background: #fff;
    border-color: #fff;
    color: var(--kx-petrol);
  }

  .kx-home {
    padding-block: 3rem 4rem;
  }
  .kx-home__lead {
    color: var(--kx-muted);
    font-size: var(--kx-text-lg);
  }
  .kx-roadmap {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 30rem;
  }
  .kx-roadmap li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--kx-line);
    color: var(--kx-muted);
  }
  .kx-roadmap li.is-done {
    color: var(--kx-ink);
  }
  .kx-roadmap__id {
    font-family: var(--kx-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    width: 2rem;
    flex: none;
    color: var(--kx-line-strong);
  }
  .kx-roadmap li.is-done .kx-roadmap__id {
    color: var(--kx-red);
  }
</style>
