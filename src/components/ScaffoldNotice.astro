---
// Bloc temporaire (lot 0) — confirme que le routage et le design tiennent.
// Remplacé par la vraie page d'accueil au lot 4.
import type { Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy: Record<Locale, { h1: string; p: string; label: string }> = {
  fr: {
    h1: "Nouvelle version — en construction",
    p: "Le socle multilingue est en place. Catalogue, fiches produit et pages de contenu arrivent lot par lot.",
    label: "Langue active",
  },
  en: {
    h1: "New version — under construction",
    p: "The multilingual foundation is live. Catalogue, product pages and content pages land batch by batch.",
    label: "Active language",
  },
  de: {
    h1: "Neue Version — im Aufbau",
    p: "Das mehrsprachige Fundament steht. Katalog, Produktseiten und Inhaltsseiten folgen Schritt für Schritt.",
    label: "Aktive Sprache",
  },
};
const c = copy[locale];

const roadmap = [
  ["L0", "Socle · routage i18n · design", true],
  ["L1", "Catalogue & navigation", false],
  ["L2", "Fiche produit & variations", false],
  ["L3", "Panier & passage en caisse", false],
  ["L4", "Pages de contenu", false],
  ["L5", "Recherche · perf · SEO", false],
  ["L6", "Bascule", false],
] as const;
---

<section class="kx-scaffold">
  <div class="kx-container">
    <p class="kx-eyebrow">Kinkyx · {c.label} : {locale.toUpperCase()}</p>
    <h1>{c.h1}</h1>
    <p class="kx-scaffold__lead">{c.p}</p>

    <ol class="kx-roadmap">
      {
        roadmap.map(([id, text, done]) => (
          <li class:list={{ "is-done": done }}>
            <span class="kx-roadmap__id">{id}</span>
            <span>{text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .kx-scaffold {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .kx-scaffold h1 {
    max-width: 20ch;
  }
  .kx-scaffold__lead {
    max-width: var(--kx-measure);
    color: var(--kx-muted);
    font-size: var(--kx-text-lg);
  }
  .kx-roadmap {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 30rem;
  }
  .kx-roadmap li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--kx-line);
    color: var(--kx-muted);
  }
  .kx-roadmap li.is-done {
    color: var(--kx-ink);
  }
  .kx-roadmap__id {
    font-family: var(--kx-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    width: 2rem;
    flex: none;
    color: var(--kx-line-strong);
  }
  .kx-roadmap li.is-done .kx-roadmap__id {
    color: var(--kx-red);
  }
</style>
