---
import LangSwitcher from "@/components/LangSwitcher.astro";
import { useTranslations, routePath } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { ACCOUNT_URL } from "@/consts";
import { isStub } from "@/lib/catalog";
import { mainNav } from "@/lib/nav";

interface Props {
  locale: Locale;
  /** URLs équivalentes par langue de la page courante (slugs traduits) */
  alternates?: Partial<Record<Locale, string>>;
}
const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const home = locale === "fr" ? "/" : `/${locale}/`;

const nav = mainNav(locale);
---

<header class="kx-header">
  <div class="kx-container kx-header__inner">
    <button
      class="kx-burger"
      type="button"
      data-nav-toggle
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="kx-drawer"
    >
      <span></span><span></span><span></span>
    </button>

    <a class="kx-header__brand" href={home} aria-label="Kinkyx — accueil">
      <span class="kx-header__logo">KINKYX</span>
      <span class="kx-header__tag">{t("meta.tagline")}</span>
    </a>

    <nav class="kx-nav" aria-label="Navigation principale">
      <ul class="kx-nav__list">
        {
          nav.map((node) => (
            <li class:list={["kx-nav__item", { "has-children": node.children.length > 0 }]}>
              <a href={node.href}>{node.label}</a>
              {node.children.length > 0 && (
                <div class="kx-nav__panel">
                  <ul>
                    {node.children.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="kx-header__actions">
      <div class="kx-header__desk">
        <LangSwitcher alternates={alternates} />
        <a class="kx-header__icon" href={routePath("search", locale)} aria-label={t("nav.search")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
        <a class="kx-header__icon" href={ACCOUNT_URL} rel="nofollow" aria-label={t("nav.account")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
          </svg>
        </a>
      </div>
      <a class="kx-header__icon kx-cart-link" href={routePath("wishlist", locale)} aria-label={t("wishlist.title")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7.5-4.7-10-9.2C.6 9 1.8 5.3 5.2 4.6 7.5 4.1 9.8 5 12 7.3 14.2 5 16.5 4.1 18.8 4.6c3.4.7 4.6 4.4 3.2 7.2C19.5 16.3 12 21 12 21z"></path>
        </svg>
        <span class="kx-cart-count" data-wishlist-count hidden>0</span>
      </a>
      <a class="kx-header__icon kx-cart-link" href={routePath("cart", locale)} aria-label={t("nav.cart")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="kx-cart-count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>
  {isStub && <p class="kx-header__stub">catalogue non chargé — build sans les clés API</p>}

  <div class="kx-drawer" id="kx-drawer" data-nav-drawer hidden>
    <nav class="kx-drawer__nav" aria-label="Menu principal">
      <ul class="kx-drawer__list">
        {
          nav.map((node) => (
            <li class="kx-drawer__item">
              <a href={node.href}>{node.label}</a>
              {node.children.length > 0 && (
                <ul class="kx-drawer__sub">
                  {node.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="kx-drawer__foot">
        <a href={routePath("search", locale)}>{t("nav.search")}</a>
        <a href={ACCOUNT_URL} rel="nofollow">{t("nav.account")}</a>
        <LangSwitcher alternates={alternates} />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const drawer = document.getElementById("kx-drawer");
  if (btn && drawer) {
    const set = (open: boolean) => {
      drawer.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("kx-noscroll", open);
    };
    btn.addEventListener("click", () => set(drawer.hidden));
    drawer.addEventListener("click", (e) => {
      if (e.target === drawer) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !drawer.hidden) set(false);
    });
    drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
  }
</script>

<style>
  .kx-header {
    border-bottom: 1px solid var(--kx-line);
    background: var(--kx-paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .kx-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--kx-header-h);
    padding-block: 0.75rem;
  }
  .kx-header__brand {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    flex: none;
  }
  .kx-header__logo {
    font-family: var(--kx-font-display);
    font-size: 1.5rem;
    letter-spacing: 0.18em;
    color: var(--kx-petrol);
  }
  .kx-header__tag {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kx-muted);
    max-width: 22ch;
  }

  .kx-nav {
    flex: 1;
  }
  .kx-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .kx-nav__item > a {
    display: inline-block;
    padding: 0.5em 0;
    font-size: 0.82rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--kx-ink);
    white-space: nowrap;
  }
  .kx-nav__item > a:hover {
    color: var(--kx-red);
  }
  .kx-nav__item {
    position: relative;
  }
  .kx-nav__panel {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    min-width: 12rem;
    background: var(--kx-paper);
    border: 1px solid var(--kx-line);
    box-shadow: var(--kx-shadow);
    padding: 0.75rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease;
  }
  .kx-nav__item.has-children:hover .kx-nav__panel,
  .kx-nav__item.has-children:focus-within .kx-nav__panel {
    opacity: 1;
    visibility: visible;
  }
  .kx-nav__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kx-nav__panel a {
    display: block;
    padding: 0.5em 1.25rem;
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--kx-body);
    white-space: nowrap;
  }
  .kx-nav__panel a:hover {
    color: var(--kx-red);
    background: var(--kx-raise);
  }

  .kx-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
  }
  .kx-header__desk {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* --- bouton hamburger (mobile) --- */
  .kx-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.5rem;
    height: 2.5rem;
    margin-left: -0.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    flex: none;
  }
  .kx-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--kx-petrol);
  }

  /* --- tiroir de navigation (mobile) --- */
  .kx-drawer {
    display: none;
  }
  .kx-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kx-drawer__item {
    border-bottom: 1px solid var(--kx-line);
    padding: 0.35rem 0;
  }
  .kx-drawer__item > a {
    display: block;
    padding: 0.6rem 0;
    font-family: var(--kx-font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--kx-ink);
  }
  .kx-drawer__sub {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
  }
  .kx-drawer__sub a {
    display: block;
    padding: 0.4rem 0 0.4rem 1rem;
    font-size: var(--kx-text-sm);
    text-decoration: none;
    color: var(--kx-muted);
  }
  .kx-drawer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
  }
  .kx-drawer__foot > a {
    font-size: var(--kx-text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--kx-ink);
  }
  .kx-header__icon {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--kx-ink);
    text-decoration: none;
  }
  .kx-header__icon svg {
    width: 1.45rem;
    height: 1.45rem;
    display: block;
  }
  .kx-header__icon:hover {
    color: var(--kx-red);
  }
  .kx-cart-count {
    font-family: var(--kx-font-body);
    font-size: 0.62rem;
    font-weight: 700;
    background: var(--kx-red);
    color: #fff;
    border-radius: 999px;
    min-width: 1.15em;
    padding: 0.1em 0.35em;
    text-align: center;
  }
  .kx-header__stub {
    margin: 0;
    padding: 0.25rem;
    text-align: center;
    font-size: 0.7rem;
    background: var(--kx-warn-wash, #f1e8d9);
    color: var(--kx-warn, #93641e);
  }

  @media (max-width: 62rem) {
    .kx-nav,
    .kx-header__tag,
    .kx-header__desk {
      display: none;
    }
    .kx-burger {
      display: flex;
    }
    .kx-header__inner {
      gap: 0.75rem;
    }
    .kx-header__brand {
      margin-right: auto;
    }
    .kx-header__logo {
      font-size: 1.25rem;
    }

    .kx-drawer {
      display: block;
      position: fixed;
      inset: var(--kx-header-h) 0 0 0;
      background: var(--kx-paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.5rem clamp(1rem, 4vw, 2rem) 4rem;
      z-index: 49;
    }
  }
</style>
