---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { type Product, productPath, priceLabel, formatPrice } from "@/lib/catalog";

interface Props {
  product: Product;
  locale: Locale;
  /** attributs data-* posés sur la carte (utilisés pour le filtrage catégorie) */
  attrs?: Record<string, string | number>;
}
const { product, locale, attrs = {} } = Astro.props;
const t = useTranslations(locale);

const href = productPath(product, locale);
const name = product.name[locale] || product.name.fr;
const pic = product.images[0] ?? null;
const img = pic?.src ?? null;
const alt = pic?.alt || name;

const hasRange =
  product.price.max != null && product.price.min != null && product.price.max > product.price.min;
---

<article class="kx-card" {...attrs}>
  <button
    type="button"
    class="kx-card__wish"
    data-wish-toggle
    data-key={product.key}
    aria-pressed="false"
    aria-label={t("wishlist.add")}
    title={t("wishlist.add")}
  >
    ♥
  </button>
  <a class="kx-card__link" href={href}>
    <div class="kx-card__media">
      {
        img ? (
          <img
            src={img}
            srcset={pic?.srcset ?? undefined}
            sizes="(min-width: 60rem) 22vw, (min-width: 34rem) 31vw, 47vw"
            alt={alt}
            loading="lazy"
            decoding="async"
            width="600"
            height="600"
          />
        ) : (
          <span class="kx-card__noimg" aria-hidden="true">Kinkyx</span>
        )
      }
      {product.price.onSale && <span class="kx-card__badge">-</span>}
    </div>
    <div class="kx-card__body">
      <h3 class="kx-card__title">{name}</h3>
      <p class="kx-card__price">
        {hasRange && <span class="kx-card__from">{t("product.from")} </span>}
        {formatPrice(product.price.min)}
      </p>
    </div>
  </a>
</article>
