# --- Backend WooCommerce lu au moment du build ---
# En dev : dev.kinkyx-shop.com   |   En prod : back.kinkyx-shop.com
WOO_API_URL=https://dev.kinkyx-shop.com/wp-json

# Clés API REST WooCommerce (WooCommerce > Réglages > Avancé > API REST)
# Lecture seule suffit pour le build.
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Protection htaccess du site de dev (user:pass). Laisser vide en prod.
SITE_BASIC_AUTH=kinkyxdev:xxxxxxxxxxxx

# URL publique du front (pour sitemap / hreflang / canonicals)
PUBLIC_SITE_URL=https://www.kinkyx-shop.com

# URL du checkout WooCommerce (bascule vers le tunnel de paiement)
PUBLIC_CHECKOUT_URL=https://back.kinkyx-shop.com

# Préproduction : ajoute <meta name=robots noindex> sur toutes les pages
PUBLIC_NOINDEX=1

# Secret du webhook de reconstruction (POST /_hooks/rebuild?key=...).
# Laisser vide = endpoint désactivé (503). Générer une chaîne longue et aléatoire.
REBUILD_SECRET=
